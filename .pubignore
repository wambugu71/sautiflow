# .pubignore

build/
doc/
sautify/
sautiplay/
/stitch
docs/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
android/.cxx/
android/.gradle/
android/local.properties
ios/Flutter/
macos/Flutter/
windows/flutter/
linux/flutter/
example/build/
example/.dart_tool/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/android/.gradle/
example/android/local.properties
*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.exe
test_*
*.py
/analyze*
example/android/build/
example/macos/Flutter/

# Whitelist prebuilt native libraries for all platforms
!native/
!native/**
!native/**/*.so*
!native/**/*.dll
!native/**/*.lib
!native/**/*.a
!native/**/*.xcframework
!native/**/*.h

dart_ytmusic_api/
test_extract_streams/
example/build_temp/
example/native/
logs_actions/
audio_engine.dll
sautiflow.dll
pub_dry_run*.txt
*.py
minimal_streamer.cpp
test_*

# Unneeded third_party documentation and tests to stay under 10 MB pub archive limit
third_party/*/docs/
third_party/*/doc/
third_party/*/examples/
third_party/*/tests/
third_party/*/frontend/
third_party/*/plugins/
third_party/*/m4/
third_party/*/autogen.sh
